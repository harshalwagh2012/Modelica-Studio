<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModelicaStudio.UI.ViewModels"
        x:Class="ModelicaStudio.UI.Views.SimulationSetupDialog"
        x:DataType="vm:SimulationSetupViewModel"
        Title="Simulation Setup"
        Width="560"
        Height="610"
        MinWidth="520"
        MinHeight="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="24,20" Background="#FAFAF8" BorderBrush="#E5E5E2" BorderThickness="0,0,0,1">
      <StackPanel Spacing="5">
        <TextBlock Text="SIMULATION SETUP" FontSize="11" FontWeight="SemiBold" Foreground="#646464" LetterSpacing="1.2" />
        <TextBlock Text="Configure the OpenModelica experiment" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Settings are stored with the active model when a project is open."
                   Foreground="#646464" FontSize="12" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Grid Margin="24" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
        <TextBlock Grid.Row="0" Text="Start time" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding StartTime}" FormatString="0.############" Increment="0.1" />

        <TextBlock Grid.Row="1" Text="Stop time" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding StopTime}" FormatString="0.############" Increment="0.1" />

        <TextBlock Grid.Row="2" Text="Number of intervals" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding NumberOfIntervals}" Minimum="1" Maximum="10000000" Increment="100" />

        <TextBlock Grid.Row="3" Text="Output interval" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Interval, StringFormat='{}{0:G12}'}" IsReadOnly="True"
                 Background="#F7F7F5" />

        <TextBlock Grid.Row="4" Text="Tolerance" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Tolerance}" FormatString="0.############" Increment="0.000001" Minimum="0.000000000001" />

        <TextBlock Grid.Row="5" Text="Integration method" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Method}" PlaceholderText="dassl" />

        <TextBlock Grid.Row="6" Text="Output format" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OutputFormat}" PlaceholderText="mat" />

        <TextBlock Grid.Row="7" Text="Variable filter" VerticalAlignment="Center" />
        <StackPanel Grid.Row="7" Grid.Column="1" Spacing="5">
          <TextBox Text="{Binding VariableFilter}" PlaceholderText="Optional regular expression" />
          <TextBlock Text="Leave empty to retain OpenModelica's default result variables."
                     FontSize="11" Foreground="#777773" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="24,16" Background="#FAFAF8" BorderBrush="#E5E5E2" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding ValidationMessage}" Foreground="#9B2C2C" FontSize="11"
                   TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding HasValidationError}" />
        <Button Grid.Column="1" Content="Cancel" Click="HandleCancel" Padding="18,8" Margin="8,0,0,0" />
        <Button Grid.Column="2" Content="Save Settings" Click="HandleSave" Padding="18,8" Margin="8,0,0,0" />
        <Button Grid.Column="3" Content="Run Simulation" Click="HandleRun" Padding="18,8" Margin="8,0,0,0"
                Background="#263746" Foreground="#FFFFFF" />
      </Grid>
    </Border>
  </Grid>
</Window>
